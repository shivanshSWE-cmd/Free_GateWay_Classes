{
  "name": "aktu-notes-store",
  "version": "1.0.0",
  "description": "Full-stack clone of AKTU BTech Notes Store (Gateway Classes) with complete data, REST API backend, and responsive cyberpunk frontend.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node --watch server/server.js",
    "extract": "node scripts/extract_all_data.js && node scripts/prepare_public.js",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android"
  },
  "keywords": [
    "aktu",
    "btech-notes",
    "gateway-classes",
    "pyq-bank",
    "multiatom",
    "express-backend",
    "rest-api"
  ],
  "author": "Shivansh",
  "license": "MIT",
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  }
}
